{
  "expo": {
    "name": "Hello English!",
    "slug": "hello-english",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "helloenglish",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.aymen.helloenglish",
      "supportsTablet": true
    },
    "android": {
      "package": "com.aymen.helloenglish",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF8A3D"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7E8"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Le micro sert uniquement au jeu « Parle » : l'élève répète un mot et l'application l'écoute.",
          "speechRecognitionPermission": "La reconnaissance vocale sert à vérifier la prononciation dans le jeu « Parle ».",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ]
  }
}
